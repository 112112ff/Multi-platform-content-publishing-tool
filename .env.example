MINIMAX_API_KEY=replace_with_your_minimax_api_key
MINIMAX_MODEL=MiniMax-M2.7
# 中国大陆账号建议使用 api.minimaxi.com；国际账号可改为 https://api.minimax.io/v1/chat/completions
MINIMAX_API_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_PROXY_PORT=8787
# 普通 npm run dev 默认会使用线上代理 https://contentbridge.onrender.com，方便评审下载即用。
# 如果要强制使用本机代理，取消下一行注释，或直接运行 npm run dev:agent。
# VITE_AGENT_BASE_URL=http://127.0.0.1:8787
