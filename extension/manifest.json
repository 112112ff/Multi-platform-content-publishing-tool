{
  "manifest_version": 3,
  "name": "ContentBridge Publisher Bridge",
  "version": "0.1.0",
  "description": "Receive ContentBridge publish jobs and open creator pages with prepared drafts.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://mp.weixin.qq.com/*",
    "https://www.zhihu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://member.bilibili.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://creator.douyin.com/*",
    "https://weibo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://mp.weixin.qq.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*",
        "https://member.bilibili.com/*",
        "https://creator.xiaohongshu.com/*",
        "https://creator.douyin.com/*",
        "https://weibo.com/*"
      ],
      "js": ["platform-fill.js"],
      "run_at": "document_idle"
    }
  ]
}
